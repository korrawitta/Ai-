# SMTP settings for the POST /api/notify endpoint (used by the
# "เตือนฉันอีกครั้งใน 7 วัน" button on the Rebalance screen).
# Copy this file to "backend/.env" and fill in real values —
# backend/.env is gitignored and never committed.

# For Gmail: create an "App Password" (not your normal login password)
# at https://myaccount.google.com/apppasswords — requires 2-Step
# Verification to be turned on for the Google account first.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=youraddress@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM_EMAIL=youraddress@gmail.com
